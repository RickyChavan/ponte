# Copy to .env and fill in. Never commit .env.
DATABASE_PATH=ponte.db
# Required to use /api/admin/*; use a long random string (e.g. `python3 -c "import secrets;print(secrets.token_urlsafe(32))"`).
ADMIN_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,https://ponte.co.in,https://www.ponte.co.in
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=600
# Set true only behind a reverse proxy you control.
TRUST_PROXY=false

# Optional alerts for new enquiries (leave blank to skip)
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=hello@ponte.co.in
